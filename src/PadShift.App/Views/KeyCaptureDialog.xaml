<Window x:Class="PadShift.App.Views.KeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L086}"
        Width="440"
        Height="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Focusable="True"
        Background="#FF1B1B21"
        Foreground="#FFE8E8EE"
        PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{DynamicResource L086}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{DynamicResource L112}"
                   Foreground="#FF9A9AA6"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{DynamicResource L013}"
                   Foreground="#FF6F6F7C"
                   FontSize="11"
                   Margin="0,4,0,0"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Window>
