<Window x:Class="PadShift.App.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L034}"
        Width="760"
        Height="680"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF1B1B21"
        Foreground="#FFE8E8EE"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2C2C36" />
            <Setter Property="BorderBrush" Value="#FF3C3C4A" />
            <Setter Property="Foreground" Value="#FFE8E8EE" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A48" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF23232C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF8F8F9C" />
            <Setter Property="Margin" Value="0,12,0,3" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF6F6F7C" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFB9D8FF" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 常规 -->
            <TabItem Header="{DynamicResource L071}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{DynamicResource L055}" Style="{StaticResource SectionHeader}" />

                        <CheckBox Content="{DynamicResource L056}"
                                  IsChecked="{Binding MinimizeToTrayOnStart, Mode=TwoWay}"
                                  Foreground="#FFDADAE2"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="{DynamicResource L042}"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                  Foreground="#FFDADAE2" />
                        <CheckBox Content="{DynamicResource prefs.focusloss}"
                                  IsChecked="{Binding TurnRemapOffOnFocusLoss, Mode=TwoWay}"
                                  Foreground="#FFDADAE2"
                                  Margin="0,8,0,2" />
                        <TextBlock Text="{DynamicResource prefs.focuslossHint}"
                                   Style="{StaticResource Hint}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource prefs.stopmacro}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding StopMacroHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220"
                                 HorizontalAlignment="Left"
                                 Height="28"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="{DynamicResource prefs.stopmacroHint}"
                                   Style="{StaticResource Hint}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />

                        <TextBlock Text="{DynamicResource L130}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding Language, Mode=TwoWay}"
                                  Width="220"
                                  HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource L063}"
                                   Style="{StaticResource Hint}" />

                        <TextBlock Text="{DynamicResource L015}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="{DynamicResource L104}"
                                    Click="OnBrowseProfilesRoot"
                                    Style="{StaticResource FlatButton}"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding ProfilesRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Height="28" />
                        </DockPanel>
                        <TextBlock Text="{DynamicResource L114}"
                                   Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 手柄 / Slots -->
            <TabItem Header="{DynamicResource L080}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{DynamicResource L082}" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="{DynamicResource L028}"
                                  IsChecked="{Binding Use3DGamepad, Mode=TwoWay}"
                                  Foreground="#FFDADAE2"
                                  Margin="0,0,0,8" />
                        <TextBlock Text="{DynamicResource L027}"
                                   Style="{StaticResource Hint}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{DynamicResource L011}" Foreground="#FFDADAE2" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding GamepadModels}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding GamepadModelId, Mode=TwoWay}"
                                  Height="28"
                                  HorizontalAlignment="Left"
                                  MinWidth="240">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource L134}"
                                   Style="{StaticResource Hint}"
                                   Margin="0,4,0,16" />

                        <TextBlock Text="{DynamicResource prefs.outputSection}" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{DynamicResource prefs.perf}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding PerformanceOptions}"
                                  SelectedItem="{Binding VirtualPadPerformance, Mode=TwoWay}"
                                  Width="160"
                                  HorizontalAlignment="Left" />
                        <TextBlock Text="{DynamicResource prefs.perfHint}"
                                   Style="{StaticResource Hint}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,12" />

                        <CheckBox Content="{DynamicResource prefs.udp}"
                                  IsChecked="{Binding UdpOutputEnabled, Mode=TwoWay}"
                                  Foreground="#FFDADAE2"
                                  Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource prefs.udpPort}" VerticalAlignment="Center" Foreground="#FFDADAE2" Margin="0,0,8,0" />
                            <TextBox Text="{Binding UdpOutputPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="90"
                                     Height="26"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource prefs.udpHint}"
                                   Style="{StaticResource Hint}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,12" />

                        <TextBlock Text="{DynamicResource prefs.mappingsHotkey}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding MappingsOverlayHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220"
                                 HorizontalAlignment="Left"
                                 Height="28"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="{DynamicResource prefs.mappingsHint}"
                                   Style="{StaticResource Hint}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,12" />

                        <CheckBox Content="{DynamicResource prefs.maskpaddles}"
                                  IsChecked="{Binding MaskPaddleButtons, Mode=TwoWay}"
                                  Foreground="#FFDADAE2"
                                  Margin="0,0,0,2" />
                        <TextBlock Text="{DynamicResource prefs.maskpaddlesHint}"
                                   Style="{StaticResource Hint}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="{DynamicResource L101}" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding SlotHotkeysExplanation}"
                                   Style="{StaticResource Hint}" />
                        <TextBlock Text="{Binding SlotComboExplanation}"
                                   Style="{StaticResource Hint}"
                                   Margin="0,4,0,10" />

                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1E1E24"
                                            BorderBrush="#FF2E2E38"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Caption}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFB9D8FF" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         Height="26"
                                                         Margin="0,0,10,0" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding ComboInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         Height="26"
                                                         ToolTip="{DynamicResource L121}" />
                                            </Grid>

                                            <TextBlock Text="{Binding ComboError}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Foreground="#FFF0A0A0"
                                                       Margin="0,6,0,0" />

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource L146}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#FFDADAE2" />
                                                <Slider Grid.Column="1"
                                                        Minimum="50"
                                                        Maximum="2500"
                                                        TickFrequency="50"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding HoldDurationMs, Mode=TwoWay}"
                                                        VerticalAlignment="Center" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding HoldDurationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         Height="26"
                                                         Margin="8,0,0,0" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding HoldRangeText}"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Margin="8,0,0,0"
                                                           Foreground="#FF6F6F7C" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 配置 -->
            <TabItem Header="{DynamicResource L136}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{DynamicResource L139}" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="{DynamicResource L088}"
                                  IsChecked="{Binding AutoSwitchEnabled, Mode=TwoWay}"
                                  Foreground="#FFDADAE2" />
                        <TextBlock Text="{DynamicResource L073}"
                                   Style="{StaticResource Hint}" />

                        <TextBlock Text="{DynamicResource L138}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="%LOCALAPPDATA%\PadShift\settings.json"
                                   Foreground="#FFB8E0FF"
                                   FontFamily="Consolas" />
                        <TextBlock Text="{DynamicResource L129}"
                                   Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 径向菜单 -->
            <TabItem Header="{DynamicResource L075}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{DynamicResource L076}" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="{DynamicResource L059}"
                                  IsChecked="{Binding RadialMenu.Enabled, Mode=TwoWay}"
                                  Foreground="#FFDADAE2"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="{DynamicResource L126}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RadialMenu.TriggerText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Height="28"
                                 Width="240"
                                 HorizontalAlignment="Left"
                                 ToolTip="{DynamicResource L030}" />
                        <TextBlock Text="{Binding RadialMenu.TriggerHint}" Style="{StaticResource Hint}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L087}" VerticalAlignment="Center" Foreground="#FFDADAE2" />
                            <Slider Grid.Column="1"
                                    Minimum="100"
                                    Maximum="2000"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding RadialMenu.HoldDurationMs, Mode=TwoWay}" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding RadialMenu.HoldDurationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Height="26"
                                     Margin="8,0,0,0" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding RadialMenu.HoldRangeText}"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Margin="8,0,0,0"
                                       Foreground="#FF6F6F7C" />
                        </Grid>

                        <TextBlock Text="{DynamicResource L039}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RadialMenu.Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Height="28"
                                 Width="240"
                                 HorizontalAlignment="Left"
                                 ToolTip="{DynamicResource L029}" />
                        <TextBlock Text="{DynamicResource L110}"
                                   Style="{StaticResource Hint}" />

                        <TextBlock Text="{DynamicResource L078}" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                        <ItemsControl ItemsSource="{Binding RadialMenu.Sectors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1E1E24"
                                            BorderBrush="#FF2E2E38"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Caption}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="#FFB9D8FF" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center"
                                                     Height="26"
                                                     Margin="0,0,8,0" />
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding Actions}"
                                                      SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                                      DisplayMemberPath="Label"
                                                      Height="26"
                                                      Margin="0,0,8,0" />
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding Argument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center"
                                                     Height="26"
                                                     ToolTip="{Binding ArgumentHint}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding RadialMenu.ValidationError}"
                                   Foreground="#FFF0A0A0"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource L051}"
                                   Style="{StaticResource Hint}" />
                        <TextBlock Text="{DynamicResource L070}"
                                   Style="{StaticResource Hint}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 叠加层 -->
            <TabItem Header="{DynamicResource L053}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{DynamicResource L053}" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="{DynamicResource L058}"
                                  IsChecked="{Binding Overlay.Enabled, Mode=TwoWay}"
                                  Foreground="#FFDADAE2"
                                  Margin="0,0,0,6" />
                        <CheckBox Content="{DynamicResource L096}"
                                  IsChecked="{Binding Overlay.ShowToast, Mode=TwoWay}"
                                  Foreground="#FFDADAE2"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{DynamicResource L044}" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{DynamicResource L095}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Overlay.Monitors}"
                                  SelectedItem="{Binding Overlay.SelectedMonitor, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Height="26"
                                  Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource L090}"
                                   Style="{StaticResource Hint}" />
                        <CheckBox Content="{DynamicResource L094}"
                                  IsChecked="{Binding Overlay.ShowCrosshair, Mode=TwoWay}"
                                  Foreground="#FFDADAE2"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="{DynamicResource L069}"
                                  IsChecked="{Binding Overlay.CenterOnScreen, Mode=TwoWay}"
                                  Foreground="#FFDADAE2" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L036}" VerticalAlignment="Center" Foreground="#FFDADAE2" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Overlay.OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding Overlay.IsOffsetEnabled}"
                                     VerticalContentAlignment="Center"
                                     Height="26"
                                     Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource L037}" VerticalAlignment="Center" Foreground="#FFDADAE2" />
                            <TextBox Grid.Column="3"
                                     Text="{Binding Overlay.OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding Overlay.IsOffsetEnabled}"
                                     VerticalContentAlignment="Center"
                                     Height="26" />
                        </Grid>

                        <TextBlock Text="{DynamicResource L074}" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Overlay.Shapes}"
                                      SelectedValue="{Binding Overlay.Shape, Mode=TwoWay}"
                                      SelectedValuePath="Shape"
                                      DisplayMemberPath="Label"
                                      Width="96"
                                      Height="26" />
                            <TextBlock Text="{DynamicResource L064}" VerticalAlignment="Center" Margin="14,0,4,0" Foreground="#FF8F8F9C" />
                            <TextBox Text="{Binding Overlay.Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"
                                     Height="26"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Text="{DynamicResource L120}" VerticalAlignment="Center" Margin="14,0,4,0" Foreground="#FF8F8F9C" />
                            <TextBox Text="{Binding Overlay.Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="52"
                                     Height="26"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Text="{DynamicResource L152}" VerticalAlignment="Center" Margin="14,0,4,0" Foreground="#FF8F8F9C" />
                            <TextBox Text="{Binding Overlay.Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="110"
                                     Height="26"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{DynamicResource L000}" />
                        </StackPanel>

                        <TextBlock Text="{DynamicResource L091}" Style="{StaticResource FieldLabel}" />
                        <CheckBox Content="{DynamicResource L060}"
                                  IsChecked="{Binding Overlay.UseMagnifier, Mode=TwoWay}"
                                  Foreground="#FFDADAE2" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{DynamicResource L033}" VerticalAlignment="Center" Foreground="#FF8F8F9C" />
                            <TextBox Text="{Binding Overlay.Magnification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="56"
                                     Height="26"
                                     Margin="6,0,14,0"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Text="{DynamicResource L111}" VerticalAlignment="Center" Foreground="#FF8F8F9C" />
                            <TextBox Text="{Binding Overlay.MagnifierSizePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="56"
                                     Height="26"
                                     Margin="6,0,14,0"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Text="{Binding Overlay.MagnificationRangeText}"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="#FF6F6F7C" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource L119}"
                                   Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 确认 -->
            <TabItem Header="{DynamicResource L116}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{DynamicResource L117}" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{DynamicResource L050}"
                                   Style="{StaticResource Hint}"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Confirmations.Confirmations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Caption}"
                                              IsChecked="{Binding Suppressed, Mode=TwoWay}"
                                              Foreground="#FFDADAE2"
                                              Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{DynamicResource L040}"
                                Command="{Binding Confirmations.ResetAllCommand}"
                                Style="{StaticResource FlatButton}"
                                Width="120"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0" />
                        <TextBlock Text="{DynamicResource L133}"
                                   Style="{StaticResource Hint}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 关于 -->
            <TabItem Header="{DynamicResource L041}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="PadShift 1.1.0" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{DynamicResource L020}" Style="{StaticResource Hint}" />

                        <TextBlock Text="{DynamicResource update.section}" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="{DynamicResource update.check}"
                                    Command="{Binding CheckUpdateCommand}"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,0,10,0" />
                            <Button Content="{DynamicResource update.site}"
                                    Command="{Binding OpenWebsiteCommand}"
                                    Style="{StaticResource FlatButton}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource L012}" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
                        <TextBlock Text="{DynamicResource L019}"
                                   Foreground="#FFDADAE2"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource L128}"
                                   Foreground="#FF8F8F9C"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{DynamicResource L099}"
                                   Foreground="#FF8F8F9C"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{DynamicResource L102}"
                                   Style="{StaticResource Hint}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Foreground="#FFF0C070"
                   Margin="0,8,0,0" />

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button Content="{DynamicResource L077}"
                    Command="{Binding RestoreDefaultsCommand}"
                    Style="{StaticResource FlatButton}"
                    HorizontalAlignment="Left"
                    Width="96" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource L052}" Click="OnCancel" Style="{StaticResource FlatButton}"
                        Width="84" Margin="0,0,8,0" />
                <Button Content="{DynamicResource L031}" Click="OnSave" Style="{StaticResource FlatButton}"
                        Width="96" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
