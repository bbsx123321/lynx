<Window x:Class="PadShift.App.Views.GyroCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L148}"
        Width="540"
        Height="440"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FF1B1B21"
        Foreground="#FFE8E8EE"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2C2C36" />
            <Setter Property="BorderBrush" Value="#FF3C3C4A" />
            <Setter Property="Foreground" Value="#FFE8E8EE" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF8F8F9C" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFB9D8FF" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding StepTitle}" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="{Binding Status}" Foreground="#FFF0C070" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <!-- Step 1: explanation + device -->
            <StackPanel x:Name="Step0Panel">
                <TextBlock Style="{StaticResource Hint}"
                           Text="{DynamicResource L098}" />
                <TextBlock Text="{DynamicResource L135}" Style="{StaticResource Hint}" Margin="0,16,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="{DynamicResource L143}"
                            Click="OnRefreshDevices"
                            Style="{StaticResource FlatButton}"
                            Margin="8,0,0,0" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Height="30" />
                </DockPanel>
                <TextBlock Text="{Binding DeviceHint}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                <TextBlock Text="{DynamicResource L124}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Step 2: sampling -->
            <StackPanel x:Name="Step1Panel" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource L131}" Foreground="#FFDADAE2" TextWrapping="Wrap" />
                <ProgressBar Height="18"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding Progress, Mode=OneWay}"
                             Margin="0,18,0,0" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                <Button Content="{DynamicResource L144}"
                        Click="OnRestartSampling"
                        Style="{StaticResource FlatButton}"
                        Width="100"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0" />
                <TextBlock Text="{DynamicResource L140}"
                           Style="{StaticResource Hint}"
                           Margin="0,14,0,0" />
            </StackPanel>

            <!-- Step 3: result -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource L150}" Foreground="#FFB9D8FF" FontWeight="SemiBold" />
                <TextBlock Text="{Binding BiasText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{DynamicResource L107}" Foreground="#FFB9D8FF" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock Text="{Binding DriftText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <CheckBox x:Name="WriteProfileCheck"
                          Content="{DynamicResource L043}"
                          IsChecked="True"
                          Foreground="#FFDADAE2"
                          Margin="0,18,0,0" />
                <TextBlock Text="{DynamicResource L151}"
                           Style="{StaticResource Hint}"
                           Margin="0,8,0,0" />
                <TextBlock x:Name="ApplyMessage"
                           Foreground="#FFF0A0A0"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding DeviceHint}"
                   Style="{StaticResource Hint}"
                   Margin="0,8,0,0" />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button Content="{DynamicResource L023}"
                    Click="OnBack"
                    Style="{StaticResource FlatButton}"
                    Width="90"
                    HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource L052}"
                        Click="OnCancel"
                        Style="{StaticResource FlatButton}"
                        Width="84"
                        Margin="0,0,8,0" />
                <Button Content="{Binding NextButtonText}"
                        Click="OnNext"
                        IsEnabled="{Binding CanGoNext}"
                        Style="{StaticResource FlatButton}"
                        Width="110" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
