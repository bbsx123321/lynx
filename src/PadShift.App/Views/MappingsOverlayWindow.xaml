<Window x:Class="PadShift.App.Views.MappingsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lynx Mappings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="420"
        Height="560"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <!-- 映射表悬浮卡：与 OverlayWindow 同一套点击穿透样式，显示当前配置的绑定清单文本。
         内容由 MappingsOverlayWindow.SetText 提供（BindingListExporter 输出）。 -->
    <Border Background="#E6101018"
            BorderBrush="#FF46506A"
            BorderThickness="1"
            CornerRadius="8"
            Margin="10"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="CaptionText"
                       Text="Mappings"
                       Foreground="#FF9FC4EE"
                       FontWeight="Bold"
                       FontSize="13"
                       Margin="0,0,0,6" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MappingsText"
                           Foreground="#FFD6DEEA"
                           FontFamily="Consolas"
                           FontSize="11.5"
                           LineHeight="16"
                           TextWrapping="NoWrap" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
