<Window x:Class="PadShift.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L116}"
        Width="440"
        SizeToContent="Height"
        MinHeight="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF1B1B21"
        Foreground="#FFE8E8EE"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2C2C36" />
            <Setter Property="BorderBrush" Value="#FF3C3C4A" />
            <Setter Property="Foreground" Value="#FFE8E8EE" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#FFB9D8FF"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Foreground="#FFDADAE2" />

        <CheckBox x:Name="DoNotAskCheck"
                  Grid.Row="2"
                  Content="{DynamicResource L026}"
                  Margin="0,14,0,0"
                  Foreground="#FFDADAE2" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="{DynamicResource L052}"
                    Width="88"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel"
                    Style="{StaticResource FlatButton}" />
            <Button x:Name="OkButton"
                    Content="{DynamicResource L115}"
                    Width="96"
                    IsDefault="True"
                    Click="OnOk"
                    Style="{StaticResource FlatButton}" />
        </StackPanel>
    </Grid>
</Window>
