<Window x:Class="PadShift.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadShift Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <Canvas x:Name="CrosshairCanvas" IsHitTestVisible="False" />
        <Grid x:Name="MagnifierHost" Visibility="Collapsed" IsHitTestVisible="False">
            <Ellipse x:Name="MagnifierRing"
                     Stroke="#B0000000"
                     StrokeThickness="2"
                     Fill="#FF101018" />
            <Image x:Name="MagnifierImage" Stretch="Fill" />
        </Grid>
        <Border x:Name="ToastHost"
                Background="#E6101018"
                BorderBrush="#FF46506A"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,8"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FFF2F6FF"
                       TextWrapping="Wrap" />
        </Border>
    </Canvas>
</Window>
