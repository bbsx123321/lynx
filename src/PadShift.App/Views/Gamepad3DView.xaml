<UserControl x:Class="PadShift.App.Views.Gamepad3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="360"
             d:DesignWidth="460"
             Focusable="False"
             ClipToBounds="True"
             Background="Transparent">

    <!-- The scene (camera, lights, model) is built in code-behind. The canvas only carries the crisp
         2D captions: text rendered as 3D geometry would look blurry. The 2D gradient backdrop is the
         studio floor; the model's contact shadow is a soft 3D ellipse so it parallaxes with the pad. -->
    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.40" RadiusX="0.78" RadiusY="0.86">
                <GradientStop Color="#FF1D2737" Offset="0.0" />
                <GradientStop Color="#FF111823" Offset="0.48" />
                <GradientStop Color="#FF0A0E15" Offset="0.78" />
                <GradientStop Color="#FF06080D" Offset="1.0" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Soft floor reflection: a cool glow under the pad, fading into the background. -->
        <Rectangle VerticalAlignment="Bottom"
                   Height="132"
                   IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#001D3852" Offset="0.0" />
                    <GradientStop Color="#331E3B55" Offset="0.62" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Vignette keeps the eye on the controller. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.72" RadiusY="0.78">
                    <GradientStop Color="#00000000" Offset="0.55" />
                    <GradientStop Color="#66000000" Offset="1.0" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Viewport3D x:Name="Viewport"
                    ClipToBounds="True"
                    IsHitTestVisible="True"
                    Focusable="False" />

        <Canvas x:Name="LabelLayer"
                IsHitTestVisible="False"
                ClipToBounds="True" />

        <!-- 复位视角：拖动翻转后一键回到默认 3/4 产品视角。 -->
        <Button x:Name="ResetOrbitButton"
                Content="{DynamicResource L022}"
                Click="OnResetOrbit"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,10,0"
                Padding="10,4"
                FontSize="11"
                Cursor="Hand"
                Focusable="False"
                Background="#CC1E2634"
                Foreground="#FFD6DEEA"
                BorderBrush="#FF3A4658"
                BorderThickness="1">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
            </Button.Resources>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#CC2A3546" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
